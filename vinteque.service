[Unit]
Description=Vinteque Spring Boot Application
After=syslog.target network.target postgresql.service

[Service]
User=root
Type=simple
WorkingDirectory=/var/www
ExecStart=/usr/bin/java -jar /var/www/vinteque-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target